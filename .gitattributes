*.h5 filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true

# Normalize all text files to LF in the repo and in the working tree.
# Added during the Windows -> macOS port: the tree arrived with CRLF endings
# on 344 tracked files, which broke the multi-line `bash -c` tasks in
# pixi.toml and made every file show as modified.
* text=auto eol=lf
