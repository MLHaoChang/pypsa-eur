# Copy to `pypsa-gui/backend/.env` for local multi-user auth development.
PYPSA_GUI_AUTH_ENABLED=true
# Postgres (Docker compose) — preferred for shared/cloud-like local testing:
DATABASE_URL=postgresql+psycopg://pypsa:pypsa@localhost:5432/pypsa_gui
# Or SQLite for a quick single-machine review without Docker:
# DATABASE_URL=sqlite+pysqlite:///./auth_dev.db
SECRET_KEY=change-me
SESSION_COOKIE_NAME=pypsa_gui_session
SESSION_TTL_HOURS=72
PASSWORD_TOKEN_TTL_HOURS=24
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
PUBLIC_BASE_URL=http://localhost:5173

# Optional checked-answer pilot. Restart the backend after changing these.
# Set mode to pilot to offer the chat's explicit "Check answers" option.
PYPSA_GUI_ANSWER_ASSURANCE_MODE=disabled
# Optional comma-separated profile allowlist; an empty value disables all
# calculation profiles. Omit to permit the five implemented bounded profiles.
# PYPSA_GUI_ANSWER_ASSURANCE_PROFILES=generator-dispatch/1,generator-cost/1,network-linear-cost/1,storage-unit-dispatch/1,storage-unit-cost/1
# Checked writes and qualitative model review are independently opt-in.
PYPSA_GUI_ANSWER_ASSURANCE_EFFECTS=disabled
PYPSA_GUI_ANSWER_REVIEW_MODE=disabled
