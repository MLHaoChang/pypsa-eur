function mpc = network
%% MATPOWER Case — generated by PyPSA GUI
%% Network: {{ name }}

mpc.version = '2';
mpc.baseMVA = {{ baseMVA }};

%% bus data
%%  bus_i  type  Pd     Qd     Gs  Bs  area  Vm   Va  baseKV       zone  Vmax  Vmin
mpc.bus = [
{% for b in buses %}	{{ b.bus_i }}  {{ b.type }}  {{ b.Pd }}  0  0  0  1  1.0  0  {{ b.baseKV }}  1  1.1  0.9;
{% endfor %}];

%% generator data
%%  bus  Pg  Qg  Qmax  Qmin  Vg    mBase  status  Pmax       Pmin
mpc.gen = [
{% for g in gens %}	{{ g.bus_i }}  {{ g.Pg }}  0  999  -999  1.0  100  1  {{ g.Pmax }}  {{ g.Pmin }};
{% endfor %}];

%% branch data
%%  fbus  tbus  r       x       b  rateA      rateB  rateC  ratio  angle  status
mpc.branch = [
{% for l in branches %}	{{ l.fbus }}  {{ l.tbus }}  {{ l.r }}  {{ l.x }}  {{ l.b }}  {{ l.rateA }}  0  0  0  0  1;
{% endfor %}];

%% generator cost data
%%  2  startup  shutdown  n  c(n-1)  ...  c0
mpc.gencost = [
{% for g in gens %}	2  0  0  2  {{ g.marginal_cost }}  0;
{% endfor %}];
