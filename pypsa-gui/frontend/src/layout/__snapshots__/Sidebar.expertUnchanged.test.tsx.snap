exports[`Sidebar — Expert unchanged > expanded sidebar renders the base DOM 1`] = `"<aside class="shrink-0 bg-nav border-r border-border h-full flex flex-col overflow-hidden" style="width: 240px; min-width: 240px;"><div class="flex items-center justify-between shrink-0 border-b border-border" style="height: 44px; padding-left: 14px; padding-right: 6px;"><div class="flex items-center gap-2"><span class="text-[18px] leading-none">⚡</span><span class="text-text font-bold text-[13px] tracking-tight">PyPSA Studio</span></div><button aria-label="Collapse to icon strip" title="Collapse to icon strip  [" class="flex items-center justify-center text-ink-400 hover:text-text transition-colors rounded" style="width: 24px; height: 24px;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg></button></div><div class="shrink-0 px-2 pt-2 pb-1"><button title="Assistant — ask about the open network, drive any tool, and it opens the view it is talking about." aria-pressed="false" data-testid="sidebar-assistant" class="flex items-center gap-2 w-full px-3 py-2 text-[12px] font-semibold rounded-md transition-colors" style="color: var(--color-text); background: rgba(47, 129, 247, 0.07); border: 1px solid rgba(47, 129, 247, 0.22);"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square shrink-0" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg><span class="flex-1 text-left">Assistant</span><span class="font-mono text-[9px] font-bold uppercase tracking-[0.12em] text-muted">Ask</span></button></div><div class="flex-1 overflow-y-auto overflow-x-hidden py-1"><butto