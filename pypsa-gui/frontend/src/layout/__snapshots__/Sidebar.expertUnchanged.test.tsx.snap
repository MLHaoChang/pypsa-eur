pan><span class="flex-1 text-[13px] font-medium text-text truncate min-w-0">Projects home</span></button><button title="Ownership, edit lock, scenario tree, members, and recent projects for the open project." class="flex items-center gap-3 w-full pl-6 pr-3 transition-colors text-left" style="height: 36px; border-left: 3px solid transparent;"><span class="shrink-0 text-ink-600" style="width: 16px; display: flex; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></span><span class="flex-1 text-[13px] font-medium text-text truncate min-w-0">Workspace panel</span></button></div><button class="flex items-center justify-between w-full px-4 py-2 mt-1 text-left hover:bg-panel transition-colors"><span class="text-[10px] font-bold uppercase tracking-[0.08em] text-ink-400">DATA</span><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down text-ink-400 transition-transform duration-200 shrink-0" aria-hidden="true" style="transform: rotate(0deg);"><path d="m6 9 6 6 6-6"></path></svg></button><div><button class="flex items-center gap-3 w-full pl-6 pr-3 transition-colors text-left" style="height: 36px; border-left: 3px solid transparent;"><span class="shrink-0 text-ink-600" style="width: 16px; display: flex; align-items: center;"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers" aria-