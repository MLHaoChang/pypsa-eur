+def _unbind_session(db, session) -> None:
+    """
+    A raw import produces an UNBOUND network, published by `reset_network()`
+    into the session's `scratch:<sid>` slot. Clear the session's pointer so the
+    next request resolves that slot -- exactly what `POST /api/network/reset`
+    does. Left set, `resolve_for_session` re-resolves the previously open
+    project's registry slot and the import is invisible (and a Save-As saves
+    the OLD network under the new name). Called only after a successful
+    import, so a failed one leaves the user on their project.
+    """
+    if session is None or db is None:
+        return
+    from services import active_project
+    active_project.set_active_project(db, session, None)
+
+
